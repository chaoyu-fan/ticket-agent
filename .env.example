# Reference only; this project does not auto-load .env files.
# Generate and export a real value locally with: openssl rand -hex 32
# The deliberately short placeholder below must fail controller validation.
TICKET_AGENT_TOKEN=CHANGE_ME
TICKET_AGENT_CAPABILITY_KEY=CHANGE_ME_TOO
TICKET_AGENT_PORT=4317
TICKET_AGENT_DB=ticket-agent.sqlite
TICKET_AGENT_CONTROLLER_URL=http://127.0.0.1:4317

# macOS defaults are shown for clarity; leave unset unless customizing them.
# TICKET_AGENT_CHROME=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# TICKET_AGENT_PROFILE=~/Library/Application Support/TicketAgent/ChromeProfile
# TICKET_AGENT_SANDBOX_PROFILE=~/Library/Application Support/TicketAgent/SandboxChromeProfile
