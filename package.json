{
  "name": "ticket-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Personal, fail-closed ticket purchase assistant for official Damai/Maoyan pages.",
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "start:controller": "node dist/src/controller/server.js",
    "start:runner": "node dist/src/runner/cli.js",
    "start:mock": "node dist/mock/server.js",
    "smoke": "npm run build && node scripts/smoke-mock.mjs",
    "benchmark:loopback": "tsc -p tsconfig.json && node scripts/benchmark-loopback.mjs",
    "benchmark:state-machine": "tsc -p tsconfig.json && node scripts/benchmark-state-machine.mjs",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "playwright-core": "1.62.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.9.3"
  }
}
