{
  "name": "ticket-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Local, fail-closed macOS browser assistant for official Damai/Maoyan pages.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/chaoyu-fan/ticket-agent.git"
  },
  "bugs": {
    "url": "https://github.com/chaoyu-fan/ticket-agent/issues"
  },
  "homepage": "https://github.com/chaoyu-fan/ticket-agent#readme",
  "keywords": [
    "ticketing",
    "damai",
    "maoyan",
    "macos",
    "playwright",
    "fail-closed"
  ],
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "start:controller": "node dist/src/controller/server.js",
    "start:runner": "node dist/src/runner/cli.js",
    "start:mock": "node dist/mock/server.js",
    "smoke": "npm run build && node scripts/smoke-mock.mjs",
    "benchmark:loopback": "tsc -p tsconfig.json && node scripts/benchmark-loopback.mjs",
    "benchmark:state-machine": "tsc -p tsconfig.json && node scripts/benchmark-state-machine.mjs",
    "benchmark:trusted-click": "tsc -p tsconfig.json && node scripts/benchmark-trusted-click.mjs",
    "benchmark:armed-fast-path": "tsc -p tsconfig.json && node scripts/benchmark-armed-fast-path.mjs",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "playwright-core": "1.62.0"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "typescript": "5.9.3"
  }
}
